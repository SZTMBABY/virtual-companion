<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景层：深海底渐变 + 中间一团冷光。
  用矢量而不是位图 —— 背景会被各厂商裁成圆/方/水滴，位图在 108dp 下容易糊。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF14344E" />
                <item android:offset="0.5" android:color="#FF0C2234" />
                <item android:offset="1" android:color="#FF06111C" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,20m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="20"
                android:endX="54"
                android:endY="62"
                android:type="radial"
                android:gradientRadius="34">
                <item android:offset="0" android:color="#55348CC4" />
                <item android:offset="1" android:color="#00348CC4" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
