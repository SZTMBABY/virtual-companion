# ---- added for this project ----
/app/build
/.kotlin
/build

# Scratch download/unpack dirs used by tools/fetch_models.sh
/.tmp_aar
/.tmp_asr
/.tmp_kws
/.tmpres
/scripts/tmp

# Model / native-lib cache for tools/fetch_models.sh (safe to delete, re-downloaded)
/.cache

# ---- Large binaries: NOT committed ----
# Gradle/AAR payloads are downloaded by tools/fetch_models.sh and verified
# against tools/models.sha256. Keeping them out of git keeps clones small and
# avoids re-publishing upstream binaries (sherpa-onnx, Silero VAD) or models.
/app/libs/*.aar
/app/libs/*.jar
/app/src/main/assets/asr/*.onnx
/app/src/main/assets/asr/tokens.txt
/app/src/main/assets/kws/*.onnx
/app/src/main/assets/kws/en.phone
/app/src/main/assets/kws/tokens.txt
/app/src/main/assets/vad/*.onnx

# Extracted Live2D asset copies. The model is NOT redistributable
# (.vtube.json has "WorkshopSharingForbidden": true), so it must never be committed.
/docs/research/live2d-asset
/docs/research/l2dprobe

# Local-only runtime assets the user imports at first launch (see docs/施工日志.md p0-2).
# Never committed: no license, and redistributing it would be a violation.
/.local_assets

# Runtime output
/shots/*.png
!/shots/.gitkeep
/.tmp_probe

# Release signing material
*.jks
*.keystore
keystore.properties
